NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/minicalls
PORT=3000

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
# Optional: use a Messaging Service sender pool for outbound SMS instead of a fixed From number.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Browser Voice (Twilio Voice JS SDK) — required for hear/speak in the web app
# Create an API Key in Twilio Console → Account → API keys & tokens
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-with-api-key-secret
# Create a TwiML App; Voice Request URL = https://YOUR_HOST/api/twilio/client-voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Client identity the browser registers as (must match inbound <Client> dial)
VOICE_CLIENT_IDENTITY=mini_calls_web

# Generate a long random value (32+ characters for production).
APP_API_KEY=replace-with-a-long-random-secret

# Public HTTPS origin of this service; do not include a path.
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app

# Optional phone fallback when the browser Client is offline.
FORWARD_CALL_TO=+15559876543
