generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CallDirection {
  inbound
  outbound
}

enum MessageDirection {
  inbound
  outbound
}

model Contact {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  createdAt DateTime @default(now())
}

model Call {
  id              String        @id @default(uuid())
  direction       CallDirection
  fromNumber      String
  toNumber        String
  status          String
  twilioCallSid   String?       @unique
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  statusUpdatedAt DateTime?
  errorCode       String?

  @@index([createdAt])
  @@index([direction, status])
}

model Message {
  id               String          @id @default(uuid())
  direction        MessageDirection
  fromNumber       String
  toNumber         String
  body             String
  status           String
  twilioMessageSid String?         @unique
  createdAt        DateTime        @default(now())
  statusUpdatedAt  DateTime?
  errorCode        String?

  @@index([createdAt])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([direction, status])
}
