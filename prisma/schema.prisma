generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  createdAt DateTime @default(now())
}

model Call {
  id             String    @id @default(uuid())
  direction      String    // outbound or inbound
  fromNumber     String
  toNumber       String
  status         String
  twilioCallSid  String?   @unique
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
}

model Message {
  id               String   @id @default(uuid())
  direction        String   // outbound or inbound
  fromNumber       String
  toNumber         String
  body             String
  status           String
  twilioMessageSid String?  @unique
  createdAt        DateTime @default(now())
}
